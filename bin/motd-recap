#!/usr/bin/env bash
# smart-motd: once-a-day Telegram recap. Triggered from motd-cache-update
# when the current hour matches TELEGRAM_RECAP_HOUR. Uses a state file to
# guarantee at-most-one delivery per calendar day even if the cache job
# fires multiple times within the configured hour (which it does — every
# 5 minutes by default).

set -u

SMART_MOTD_PREFIX="${SMART_MOTD_PREFIX:-/usr/local/lib/smart-motd}"
SMART_MOTD_CONFIG="${SMART_MOTD_CONFIG:-/etc/smart-motd/config.conf}"
SMART_MOTD_SECRETS="${SMART_MOTD_SECRETS:-/etc/smart-motd/secrets.conf}"
SMART_MOTD_CACHE_DIR="${SMART_MOTD_CACHE_DIR:-/var/cache/smart-motd}"

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERTS_LANG=en
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_THREAD_ID=""
TELEGRAM_DESTS=()
TELEGRAM_RECAP_ENABLED=false
TELEGRAM_RECAP_HOUR=9

# Disk knobs, so the recap lists exactly what the MOTD lists. Every use below
# has a :- fallback too, but declaring them keeps this file honest under set -u
# if a future change drops one of those fallbacks.
SYSTEM_DISK_AUTO=true
SYSTEM_DISK_PATHS=()
SYSTEM_DISK_EXCLUDE=()
SYSTEM_DISK_MAX=10

# shellcheck disable=SC1090
[[ -r "$SMART_MOTD_CONFIG" ]]  && . "$SMART_MOTD_CONFIG"
# shellcheck disable=SC1090
[[ -r "$SMART_MOTD_SECRETS" ]] && . "$SMART_MOTD_SECRETS"

[[ "$TELEGRAM_ALERTS_ENABLED" == "true" ]] || exit 0
[[ "$TELEGRAM_RECAP_ENABLED"  == "true" ]] || exit 0
command -v curl >/dev/null 2>&1 || exit 0

# Same multi-destination handling as motd-ssh-alert: primary tuple + extras.
ALL_DESTS=()
if [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
    ALL_DESTS+=("${TELEGRAM_BOT_TOKEN}|${TELEGRAM_CHAT_ID}|${TELEGRAM_THREAD_ID:-}")
fi
for d in "${TELEGRAM_DESTS[@]:-}"; do
    [[ -n "$d" ]] && ALL_DESTS+=("$d")
done
[[ ${#ALL_DESTS[@]} -gt 0 ]] || exit 0

NOW_HOUR=$(date +%H)
NOW_HOUR=$((10#$NOW_HOUR))   # strip leading zero
TODAY=$(date +%Y-%m-%d)

# When called from `smart-motd test-alert recap`, bypass the hour and
# state-file gates so the message goes out immediately. Also skip writing
# the state file at the end, so the real daily fire isn't suppressed.
STATE="$SMART_MOTD_CACHE_DIR/recap_last_sent"
if [[ "${SMART_MOTD_FORCE_RECAP:-}" != "1" ]]; then
    [[ "$NOW_HOUR" == "$TELEGRAM_RECAP_HOUR" ]] || exit 0
    if [[ -r "$STATE" ]]; then
        LAST=$(cat "$STATE" 2>/dev/null)
        [[ "$LAST" == "$TODAY" ]] && exit 0
    fi
fi

# ---------- gather data ----------

# Server identity: full hostname + primary interface IP, same shape as
# motd-ssh-alert so the operator immediately knows which box this came
# from. Local interface IP first because behind NAT the public IP is the
# gateway address — useless for distinguishing servers.
# Use plain `hostname` (kernel hostname) — `hostname -f` does a DNS lookup
# that on cloud / NAT'd hosts often returns junk auto-generated names.
HOSTNAME_FULL="$(hostname 2>/dev/null || hostname -f 2>/dev/null || echo unknown)"
SERVER_IP=""
if command -v ip >/dev/null 2>&1; then
    SERVER_IP=$(ip route get 1.1.1.1 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')
fi
if [[ -z "$SERVER_IP" ]] && [[ -r "$SMART_MOTD_CACHE_DIR/public_ip" ]]; then
    SERVER_IP=$(cat "$SMART_MOTD_CACHE_DIR/public_ip" 2>/dev/null)
    [[ "$SERVER_IP" == "unavailable" ]] && SERVER_IP=""
fi
if [[ -n "$SERVER_IP" ]]; then
    SERVER_DISPLAY="${HOSTNAME_FULL} (${SERVER_IP})"
else
    SERVER_DISPLAY="$HOSTNAME_FULL"
fi

# SSH logins in the last 24h (best-effort, journalctl preferred)
LOGINS_24H=0
if command -v journalctl >/dev/null 2>&1; then
    LOGINS_24H=$(journalctl _COMM=sshd --since "24 hours ago" --no-pager 2>/dev/null \
        | grep -cE 'Accepted (password|publickey|keyboard-interactive|gssapi)' || true)
elif command -v last >/dev/null 2>&1; then
    LOGINS_24H=$(last -s -24hours 2>/dev/null | grep -cv '^reboot\|^wtmp\|^$' || true)
fi
LOGINS_24H="${LOGINS_24H:-0}"

# Failed SSH attempts in last 24h — pull from cache (already populated)
FAILED_SSH=0
if [[ -r "$SMART_MOTD_CACHE_DIR/security.kv" ]]; then
    # shellcheck disable=SC1091
    . "$SMART_MOTD_CACHE_DIR/security.kv"
    FAILED_SSH="${FAILED_SSH:-0}"
fi

# Pending package updates from cache
UPDATES_COUNT=0
UPDATES_SECURITY=0
[[ -r "$SMART_MOTD_CACHE_DIR/packages_count" ]] && \
    UPDATES_COUNT=$(cat "$SMART_MOTD_CACHE_DIR/packages_count" 2>/dev/null)
[[ -r "$SMART_MOTD_CACHE_DIR/packages_security" ]] && \
    UPDATES_SECURITY=$(cat "$SMART_MOTD_CACHE_DIR/packages_security" 2>/dev/null)
UPDATES_COUNT="${UPDATES_COUNT:-0}"
UPDATES_SECURITY="${UPDATES_SECURITY:-0}"

# Reboot required? Cross-distro detection lives in cache (packages_reboot_required).
REBOOT_REQ="no"
if [[ -r "$SMART_MOTD_CACHE_DIR/packages_reboot_required" ]]; then
    REBOOT_REQ=$(cat "$SMART_MOTD_CACHE_DIR/packages_reboot_required" 2>/dev/null)
    REBOOT_REQ="${REBOOT_REQ:-no}"
fi

# Uptime in human form
UPTIME_HUMAN=""
if [[ -r /proc/uptime ]]; then
    secs=$(awk '{print int($1)}' /proc/uptime)
    days=$(( secs / 86400 ))
    hours=$(( (secs % 86400) / 3600 ))
    UPTIME_HUMAN="${days}d ${hours}h"
fi

# Average load over the last 24h, computed from samples the cache job
# appends every 5 min. Empty if no samples yet (fresh install).
AVG_LOAD=""
if [[ -s "$SMART_MOTD_CACHE_DIR/load_samples" ]]; then
    AVG_LOAD=$(awk '
        { sum += $2; n++ }
        END { if (n > 0) printf "%.2f", sum / n }
    ' "$SMART_MOTD_CACHE_DIR/load_samples")
fi

# Average memory usage % over the last 24h.
AVG_MEM=""
if [[ -s "$SMART_MOTD_CACHE_DIR/mem_samples" ]]; then
    AVG_MEM=$(awk '
        { sum += $2; n++ }
        END { if (n > 0) printf "%d", sum / n }
    ' "$SMART_MOTD_CACHE_DIR/mem_samples")
fi

# Disk usage — every disk the MOTD shows, not just '/'.
#
# This used to report the root filesystem alone (v1.7.1), which made sense
# when extra entries were hand-configured paths like '/var'. Since v1.13.0
# the list is auto-detected real block devices, and reporting only '/' meant
# the recap stayed silent about a data or backup volume filling up — exactly
# the kind of thing a once-a-day summary exists to catch.
#
# Reuses disks_prepare() from the system section so there is one definition
# of "what counts as a disk" (same filters, same SYSTEM_DISK_* config, same
# labels) instead of a second copy here that would drift.
DISK_ROWS=()
if [[ -r "$SMART_MOTD_PREFIX/lib/common.sh" ]] \
   && [[ -r "$SMART_MOTD_PREFIX/lib/sections/system.sh" ]]; then
    # shellcheck source=../lib/common.sh
    . "$SMART_MOTD_PREFIX/lib/common.sh"
    # shellcheck source=../lib/sections/system.sh
    . "$SMART_MOTD_PREFIX/lib/sections/system.sh"
fi
if declare -F disks_prepare >/dev/null 2>&1; then
    disks_prepare
    for _row in "${SMART_MOTD_DISK_ROWS[@]:-}"; do
        [[ -n "$_row" ]] && DISK_ROWS+=("$_row")
    done
fi
# Fallback: root only, in case the libraries aren't readable (partial
# upgrade, or a recap invoked with an unusual SMART_MOTD_PREFIX).
if [[ ${#DISK_ROWS[@]} -eq 0 ]]; then
    _fallback=$(df -hP / 2>/dev/null \
        | awk 'NR==2 {gsub("%","",$5); printf "/|%s|%s|%s", $3, $2, $5}')
    [[ -n "$_fallback" ]] && DISK_ROWS+=("$_fallback")
fi

# ---------- compose message ----------

if [[ "$TELEGRAM_ALERTS_LANG" == "ru" ]]; then
    MSG="📊 Ежедневная сводка · ${SERVER_DISPLAY}
🗓 ${TODAY}

🔓 SSH-входов за 24ч: ${LOGINS_24H}
🛡 Failed-попыток: ${FAILED_SSH}"
    [[ -n "$AVG_LOAD" ]] && MSG+="
📈 Средний LA (24ч): ${AVG_LOAD}"
    [[ -n "$AVG_MEM" ]]  && MSG+="
🧠 Средняя память (24ч): ${AVG_MEM}%"
    for _row in "${DISK_ROWS[@]:-}"; do
        [[ -n "$_row" ]] || continue
        IFS='|' read -r _lbl _used _size _pct <<<"$_row"
        MSG+="
💾 Диск ${_lbl}: ${_used} / ${_size} (${_pct}% занято)"
    done
    MSG+="
📦 Обновлений пакетов: ${UPDATES_COUNT}"
    [[ "$UPDATES_SECURITY" -gt 0 ]] && MSG+=" (security: ${UPDATES_SECURITY})"
    [[ -n "$UPTIME_HUMAN" ]] && MSG+="
⏱ Uptime: ${UPTIME_HUMAN}"
    if [[ "$REBOOT_REQ" == "yes" ]]; then
        MSG+="
⚠️ Требуется перезагрузка"
    fi
else
    MSG="📊 Daily recap · ${SERVER_DISPLAY}
🗓 ${TODAY}

🔓 SSH logins in 24h: ${LOGINS_24H}
🛡 Failed attempts: ${FAILED_SSH}"
    [[ -n "$AVG_LOAD" ]] && MSG+="
📈 Avg load (24h): ${AVG_LOAD}"
    [[ -n "$AVG_MEM" ]]  && MSG+="
🧠 Avg memory (24h): ${AVG_MEM}%"
    for _row in "${DISK_ROWS[@]:-}"; do
        [[ -n "$_row" ]] || continue
        IFS='|' read -r _lbl _used _size _pct <<<"$_row"
        MSG+="
💾 Disk ${_lbl}: ${_used} / ${_size} (${_pct}% used)"
    done
    MSG+="
📦 Package updates: ${UPDATES_COUNT}"
    [[ "$UPDATES_SECURITY" -gt 0 ]] && MSG+=" (security: ${UPDATES_SECURITY})"
    [[ -n "$UPTIME_HUMAN" ]] && MSG+="
⏱ Uptime: ${UPTIME_HUMAN}"
    if [[ "$REBOOT_REQ" == "yes" ]]; then
        MSG+="
⚠️ Reboot required"
    fi
fi

# ---------- send ----------
# Send to every destination. We consider the day "sent" if at least one
# destination accepted — otherwise a single broken destination would block
# all the others from being remembered as delivered.

any_ok=0
for dest in "${ALL_DESTS[@]}"; do
    IFS='|' read -r d_token d_chat d_thread <<<"$dest"
    [[ -n "$d_token" && -n "$d_chat" ]] || continue
    URL="https://api.telegram.org/bot${d_token}/sendMessage"
    args=(
        --data-urlencode "chat_id=${d_chat}"
        --data-urlencode "text=${MSG}"
        --data-urlencode "disable_web_page_preview=true"
    )
    [[ -n "$d_thread" ]] && args+=( --data-urlencode "message_thread_id=${d_thread}" )
    if curl -fsS --max-time 10 "${args[@]}" "$URL" >/dev/null 2>&1; then
        any_ok=1
    fi
done

if (( any_ok )) && [[ "${SMART_MOTD_FORCE_RECAP:-}" != "1" ]]; then
    mkdir -p "$SMART_MOTD_CACHE_DIR"
    printf '%s\n' "$TODAY" > "$STATE"
fi

exit 0
