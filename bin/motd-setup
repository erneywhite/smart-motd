#!/usr/bin/env bash
# smart-motd: interactive paged configuration wizard.
# Re-runnable; loads existing config as defaults if present.

set -u

SMART_MOTD_PREFIX="${SMART_MOTD_PREFIX:-/usr/local/lib/smart-motd}"
SMART_MOTD_CONFIG_DIR="${SMART_MOTD_CONFIG_DIR:-/etc/smart-motd}"
SMART_MOTD_CONFIG="${SMART_MOTD_CONFIG_DIR}/config.conf"

if [[ "$EUID" -ne 0 ]]; then
    echo "smart-motd setup must be run as root (sudo smart-motd setup)." >&2
    exit 1
fi

# Force colors for the wizard regardless of stdout being a tty.
SMART_MOTD_FORCE_COLOR=1
COLORS_ENABLED=true

# shellcheck source=../lib/common.sh
. "${SMART_MOTD_PREFIX}/lib/common.sh"
# shellcheck source=../lib/wizard.sh
. "${SMART_MOTD_PREFIX}/lib/wizard.sh"
detect_distro

# ---------- defaults ----------

HEADER_TEXT="Welcome"
HEADER_SPACED=true
WELCOME_TITLE=""
WELCOME_LINES=()
WARNING_LINES=(
    "Authorized access only!"
    "All connections are logged and monitored."
    "Unauthorized use may be subject to criminal prosecution."
)
SYSTEM_DISK_PATHS=("/")
SERVICES_LIST=()
NETWORK_SHOW_PUBLIC_IP=true
NETWORK_INTERFACES=()
SSL_AUTODISCOVER_LETSENCRYPT=true
SSL_DOMAINS=()
SSL_WARN_DAYS=14
SMART_DISKS=()
DIRECTORIES_LIST=()
LASTLOGIN_COUNT=3
WEATHER_CITY=""
DOCKER_FILTER=""
COLORS_ENABLED=true
THEME="classic"
COLOR_THEME="default"
FOOTER_TEXT=""

HEADER_ENABLED=true
WELCOME_ENABLED=true
WARNING_ENABLED=true
SYSTEM_ENABLED=true
MAINTENANCE_ENABLED=true
UPDATES_ENABLED=true
SERVICES_ENABLED=false
NETWORK_ENABLED=true
SSL_ENABLED=true
SECURITY_ENABLED=true
TEMPERATURE_ENABLED=auto
SMART_ENABLED=auto
DOCKER_ENABLED=auto
PODMAN_ENABLED=auto
KUBERNETES_ENABLED=auto
DIRECTORIES_ENABLED=false
LASTLOGIN_ENABLED=true
WEATHER_ENABLED=false
FOOTER_ENABLED=true

EXISTING_CONFIG=false
if [[ -r "$SMART_MOTD_CONFIG" ]]; then
    EXISTING_CONFIG=true
    # shellcheck disable=SC1090
    . "$SMART_MOTD_CONFIG"
fi
apply_theme
apply_color_theme

# ---------- i18n ----------
# `_l "english" "русский"` returns one of them based on $WIZ_LANG.
# Default: English. Kept simple — only wizard prompts/help are localized.
# All saved config values stay in English (machine-readable).

WIZ_LANG="en"
_l() { case "$WIZ_LANG" in ru) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac; }

# ---------- helpers ----------

qstr() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

write_array() {
    local name="$1"; shift
    if [[ $# -eq 0 ]]; then
        printf '%s=()\n' "$name"
        return
    fi
    printf '%s=(' "$name"
    local first=1 v
    for v in "$@"; do
        if (( first )); then first=0; else printf ' '; fi
        printf '%s' "$(qstr "$v")"
    done
    printf ')\n'
}

# ---------- preview renderers ----------
# All previews use the user's actual HEADER_TEXT (collected on the first
# config page) so the preview matches what they will see at login.

# Render the user's header text using the requested style. Style "spaced" by
# default; pass "plain"/"upper"/"lower" to override.
_preview_render_header() {
    local style="${1:-${HEADER_SPACED:+spaced}}"
    [[ -z "$style" ]] && style="plain"
    local text="${HEADER_TEXT:-Smart MOTD}"
    case "$style" in
        spaced) printf '%s%s%s\n' "${C_BOLD}${C_CYAN}" "$(spaced_text "$text")" "${C_RESET}" ;;
        upper)  printf '%s%s%s\n' "${C_BOLD}${C_CYAN}" "${text^^}" "${C_RESET}" ;;
        lower)  printf '%s%s%s\n' "${C_BOLD}${C_CYAN}" "${text,,}" "${C_RESET}" ;;
        plain|*)printf '%s%s%s\n' "${C_BOLD}${C_CYAN}" "$text"      "${C_RESET}" ;;
    esac
}

preview_theme() {
    local name="$1"
    (
        THEME="$name"
        unset THEME_BANNER_CHAR THEME_DIVIDER_CHAR THEME_KV_SEPARATOR THEME_HEADING_STYLE
        apply_theme
        section_thick_rule
        _preview_render_header
        section_thick_rule
        section_heading "System status"
        kv "Hostname" "web-01.example.net"
        kv "Uptime"   "4 days, 2 hours"
        kv "Memory"   "1238 / 32088 MB" "${C_GREEN}"
        section_rule
    )
}

preview_color_theme() {
    local name="$1"
    (
        COLOR_THEME="$name"
        apply_color_theme
        section_heading "Services"
        printf "   %sactive      %s nginx\n" "${C_GREEN}" "${C_RESET}"
        printf "   %sactive      %s postgresql\n" "${C_GREEN}" "${C_RESET}"
        printf "   %sfailed      %s redis-server\n" "${C_RED}" "${C_RESET}"
        section_rule
    )
}

preview_header_style() {
    local style="$1"
    _preview_render_header "$style"
    section_thick_rule
}

preview_kv_sep() {
    local sep_label="$1" sep
    case "$sep_label" in
        "Colon (:)")        sep=":" ;;
        "Vertical bar (│)") sep="│" ;;
        "Triangle (▸)")     sep="▸" ;;
        "Arrow (→)")        sep="→" ;;
        "Equals (=)")       sep="=" ;;
    esac
    (
        THEME_KV_SEPARATOR="$sep"
        kv "Hostname" "web-01.example.net"
        kv "Uptime"   "4 days, 2 hours"
        kv "Memory"   "1238 / 32088 MB" "${C_GREEN}"
    )
}

# ---------- wizard ----------

# Show the installed version in the wizard's top bar.
SMART_MOTD_VERSION=$(cat "${SMART_MOTD_PREFIX}/VERSION" 2>/dev/null | tr -d ' \r\n' || echo "")
if [[ -n "$SMART_MOTD_VERSION" ]]; then
    wizard_init 0 "smart-motd setup · v${SMART_MOTD_VERSION}"
else
    wizard_init 0 "smart-motd setup"
fi

# --- Page 0: language selection (always shown, hardcoded bilingual) ---
lang_choice=$(wizard_select \
    "Choose language / Выберите язык" \
    "All wizard prompts will be shown in this language. Your config values and the rendered MOTD stay in English / Системный язык MOTD не изменится — только подсказки визарда." \
    0 -- \
    "English" "Русский")
case "$lang_choice" in
    "Русский") WIZ_LANG="ru" ;;
    *)          WIZ_LANG="en" ;;
esac
_wiz_step_reset  # don't count the language picker against the user's progress

# --- intro ---

intro_body=$(_l \
"Welcome! This wizard walks you through every section of your MOTD.

For each question:
  · ↑ / ↓ (or k / j) to navigate
  · Space to toggle a checkbox
  · Enter to confirm
  · y / n shortcuts for yes/no
  · Ctrl+C to abort (your existing config is left untouched)

Detected: ${DISTRO_ID} (family: ${DISTRO_FAMILY})
Existing config: $($EXISTING_CONFIG && echo \"loaded as defaults\" || echo \"none — using built-in defaults\")

────────────────────────────────────────────
smart-motd · by @erneywhite
https://github.com/erneywhite/smart-motd" \
"Добро пожаловать! Визард проведёт через все секции вашего MOTD.

Управление:
  · ↑ / ↓ (или k / j) — навигация
  · Space — переключить чекбокс
  · Enter — подтвердить
  · y / n — быстрый ответ для да/нет
  · Ctrl+C — отменить (текущий конфиг не пострадает)

Дистрибутив: ${DISTRO_ID} (семейство: ${DISTRO_FAMILY})
Существующий конфиг: $($EXISTING_CONFIG && echo \"загружен как значения по умолчанию\" || echo \"нет — используются встроенные defaults\")

────────────────────────────────────────────
smart-motd · by @erneywhite
https://github.com/erneywhite/smart-motd")

wizard_intro "$(_l "Welcome to smart-motd" "Добро пожаловать в smart-motd")" "$intro_body"

# --- Section selector (multiselect) ---

# Detect what's actually installed so 'auto' toggles only get pre-checked
# when the underlying tool is present. Without this, fresh installs pre-check
# Docker/Podman/Kubernetes/SMART/temperature even on hosts that don't have
# them, only for those sections to silently no-op at render time.
have() { command -v "$1" >/dev/null 2>&1; }
have docker          && HAS_DOCKER=true       || HAS_DOCKER=false
have podman          && HAS_PODMAN=true       || HAS_PODMAN=false
have kubectl         && HAS_KUBECTL=true      || HAS_KUBECTL=false
have smartctl        && HAS_SMARTCTL=true     || HAS_SMARTCTL=false
if have sensors || [[ -d /sys/class/thermal ]]; then HAS_THERMAL=true; else HAS_THERMAL=false; fi

_pre()      { case "$1" in true|auto) echo 1 ;; *) echo 0 ;; esac; }
# Smarter version: 'auto' is only pre-checked when the underlying tool is
# detected. Explicit true / false values from existing config still win.
_pre_auto() {
    local val="$1" available="$2"
    case "$val" in
        true) echo 1 ;;
        false) echo 0 ;;
        auto)  [[ "$available" == "true" ]] && echo 1 || echo 0 ;;
        *) echo 0 ;;
    esac
}

mapfile -t selected_sections < <(wizard_multiselect \
    "$(_l "Sections to enable" "Включаемые секции")" \
    "$(_l \
"Pick which sections appear in the MOTD. You can re-run setup any time. Sections marked 'auto' will skip themselves on hosts without the relevant tool (docker, smartctl, etc.)." \
"Отметьте секции, которые будут показываться в MOTD. Setup можно перезапускать. Секции с 'auto' автоматически скроются, если соответствующий инструмент (docker, smartctl и т.д.) не установлен.")" \
    -- \
    "$(_pre "$HEADER_ENABLED")$(_l "Header banner" "Баннер-заголовок")" \
    "$(_pre "$WELCOME_ENABLED")$(_l "Welcome lines (URLs, admin, etc.)" "Строки приветствия (URL'ы, админ и т.п.)")" \
    "$(_pre "$WARNING_ENABLED")$(_l "Warning / legal banner" "Предупреждение / юридический баннер")" \
    "$(_pre "$SYSTEM_ENABLED")$(_l "System status (uptime, load, mem, disk)" "Состояние системы (uptime, load, память, диск)")" \
    "$(_pre "$MAINTENANCE_ENABLED")$(_l "Maintenance (reboot required)" "Обслуживание (требуется перезагрузка)")" \
    "$(_pre "$UPDATES_ENABLED")$(_l "Pending package updates" "Доступные обновления пакетов")" \
    "$(_pre "$SERVICES_ENABLED")$(_l "systemd services" "systemd-сервисы")" \
    "$(_pre "$NETWORK_ENABLED")$(_l "Network (interfaces + public IP)" "Сеть (интерфейсы + публичный IP)")" \
    "$(_pre "$SSL_ENABLED")$(_l "SSL certificates" "SSL-сертификаты")" \
    "$(_pre "$SECURITY_ENABLED")$(_l "Security (failed SSH + fail2ban)" "Безопасность (failed SSH + fail2ban)")" \
    "$(_pre_auto "$TEMPERATURE_ENABLED" "$HAS_THERMAL")$(_l "CPU temperature" "Температура CPU")" \
    "$(_pre_auto "$SMART_ENABLED" "$HAS_SMARTCTL")$(_l "Disk SMART status" "Состояние дисков (SMART)")" \
    "$(_pre_auto "$DOCKER_ENABLED" "$HAS_DOCKER")$(_l "Docker containers" "Docker-контейнеры")" \
    "$(_pre_auto "$PODMAN_ENABLED" "$HAS_PODMAN")$(_l "Podman containers" "Podman-контейнеры")" \
    "$(_pre_auto "$KUBERNETES_ENABLED" "$HAS_KUBECTL")$(_l "Kubernetes summary" "Kubernetes (краткая сводка)")" \
    "$(_pre "$DIRECTORIES_ENABLED")$(_l "Monitored directories" "Отслеживаемые каталоги")" \
    "$(_pre "$LASTLOGIN_ENABLED")$(_l "Recent logins" "Недавние логины")" \
    "$(_pre "$WEATHER_ENABLED")$(_l "Weather (wttr.in)" "Погода (wttr.in)")" \
)

# Reset toggles, then enable picked. We match on a substring so localized labels work.
HEADER_ENABLED=false; WELCOME_ENABLED=false; WARNING_ENABLED=false
SYSTEM_ENABLED=false; MAINTENANCE_ENABLED=false; UPDATES_ENABLED=false
SERVICES_ENABLED=false; NETWORK_ENABLED=false; SSL_ENABLED=false
SECURITY_ENABLED=false; TEMPERATURE_ENABLED=false; SMART_ENABLED=false
DOCKER_ENABLED=false; PODMAN_ENABLED=false; KUBERNETES_ENABLED=false
DIRECTORIES_ENABLED=false; LASTLOGIN_ENABLED=false; WEATHER_ENABLED=false

for s in "${selected_sections[@]}"; do
    case "$s" in
        *Header*|*Баннер*)                            HEADER_ENABLED=true ;;
        *Welcome*|*приветствия*)                       WELCOME_ENABLED=true ;;
        *Warning*|*Предупреждение*)                    WARNING_ENABLED=true ;;
        *"System status"*|*"Состояние системы"*)       SYSTEM_ENABLED=true ;;
        *Maintenance*|*Обслуживание*)                   MAINTENANCE_ENABLED=true ;;
        *"package updates"*|*"обновления пакетов"*)    UPDATES_ENABLED=true ;;
        *"systemd"*)                                    SERVICES_ENABLED=true ;;
        *Network*|*Сеть*)                               NETWORK_ENABLED=true ;;
        *SSL*)                                          SSL_ENABLED=true ;;
        *Security*|*Безопасность*)                      SECURITY_ENABLED=true ;;
        *temperature*|*Температура*)                    TEMPERATURE_ENABLED=auto ;;
        *SMART*)                                        SMART_ENABLED=auto ;;
        *Docker*)                                       DOCKER_ENABLED=auto ;;
        *Podman*)                                       PODMAN_ENABLED=auto ;;
        *Kubernetes*)                                   KUBERNETES_ENABLED=auto ;;
        *directories*|*каталоги*)                       DIRECTORIES_ENABLED=true ;;
        *"Recent logins"*|*"Недавние логины"*)          LASTLOGIN_ENABLED=true ;;
        *Weather*|*Погода*)                             WEATHER_ENABLED=true ;;
    esac
done

# --- Header text (asked FIRST so subsequent previews can show it) ---

if [[ "$HEADER_ENABLED" == "true" ]]; then
    HEADER_TEXT=$(wizard_text \
        "$(_l "Header text" "Текст заголовка")" \
        "$(_l \
"The big banner shown at the very top of every login. Usually your project or company name. The next pages will preview how it looks." \
"Большой баннер сверху при каждом логине. Обычно — название проекта или компании. Следующие страницы покажут предпросмотр.")" \
        "$HEADER_TEXT")

    style_choice=$(wizard_select_preview \
        "$(_l "Header style" "Стиль заголовка")" \
        "$(_l "How the header text should be rendered. Preview below uses your text." "Как именно отображать текст. Предпросмотр снизу использует ваш текст.")" \
        0 preview_header_style -- \
        "spaced" "plain" "upper" "lower")
    case "$style_choice" in
        spaced) HEADER_SPACED=true ;;
        *)      HEADER_SPACED=false ;;
    esac
    case "$style_choice" in
        upper) HEADER_TEXT="${HEADER_TEXT^^}" ;;
        lower) HEADER_TEXT="${HEADER_TEXT,,}" ;;
    esac
fi

# --- Theme picker (preview uses real HEADER_TEXT now) ---
# Drop any preset values from the previously-loaded config so the new pick
# fully takes effect (apply_theme uses := and would otherwise keep old chars).
unset THEME_BANNER_CHAR THEME_DIVIDER_CHAR THEME_KV_SEPARATOR THEME_HEADING_STYLE

theme_choice=$(wizard_select_preview \
    "$(_l "Visual theme" "Визуальная тема")" \
    "$(_l \
"Choose the rule characters and section heading style for the banner. Live preview below shows how it will look." \
"Выберите символы рамок и стиль заголовков. Предпросмотр снизу покажет результат.")" \
    0 preview_theme -- \
    "classic" "slim" "heavy" "double" "dotted" "ascii" "arrows" "stars" \
    "wave" "block" "pipes" "retro" "compact" "chevrons" "bullets" "cross" \
    "plus" "cosmic" "sharp" "zen")
THEME="$theme_choice"
unset THEME_BANNER_CHAR THEME_DIVIDER_CHAR THEME_KV_SEPARATOR THEME_HEADING_STYLE
apply_theme

# --- Color theme ---

color_choice=$(wizard_select_preview \
    "$(_l "Color palette" "Цветовая палитра")" \
    "$(_l \
"Sets the accent color used by section headings. Status colors (green/yellow/red) stay intact." \
"Задаёт основной цвет заголовков секций. Цвета статусов (зелёный/жёлтый/красный) не меняются.")" \
    0 preview_color_theme -- \
    "default" "ocean" "forest" "sunset" "amber" "mono" \
    "matrix" "neon" "coral" "mint" "sky" "gold" "snow")
COLOR_THEME="$color_choice"
apply_color_theme

# --- KV separator ---

sep_choice=$(wizard_select_preview \
    "$(_l "Key/Value separator" "Разделитель ключ/значение")" \
    "$(_l \
"Character between a label and its value (Hostname : web-01). Theme presets pick a default for you; pick differently here to override." \
"Символ между меткой и значением (Hostname : web-01). У темы есть свой default — здесь можно переопределить.")" \
    0 preview_kv_sep -- \
    "Colon (:)" "Vertical bar (│)" "Triangle (▸)" "Arrow (→)" "Equals (=)")
case "$sep_choice" in
    "Colon (:)")        THEME_KV_SEPARATOR=":" ;;
    "Vertical bar (│)") THEME_KV_SEPARATOR="│" ;;
    "Triangle (▸)")     THEME_KV_SEPARATOR="▸" ;;
    "Arrow (→)")        THEME_KV_SEPARATOR="→" ;;
    "Equals (=)")       THEME_KV_SEPARATOR="=" ;;
esac

# --- Welcome ---

if [[ "$WELCOME_ENABLED" == "true" ]]; then
    WELCOME_TITLE=$(wizard_text \
        "$(_l "Welcome title" "Заголовок приветствия")" \
        "$(_l \
"One short line shown right after the banner, e.g. 'web-01 (production)'. Leave blank to skip." \
"Одна короткая строка сразу под баннером, например 'web-01 (production)'. Оставьте пустым чтобы пропустить.")" \
        "$WELCOME_TITLE")

    mapfile -t WELCOME_LINES < <(wizard_list \
        "$(_l "Welcome KV lines" "Строки приветствия (Label|Value)")" \
        "$(_l \
"Custom labeled lines under the welcome title. Format: Label|Value (e.g. Web|https://example.com, Admin|alice)." \
"Произвольные строки под заголовком приветствия. Формат: Label|Value (например Web|https://example.com, Admin|alice).")" \
        "${WELCOME_LINES[@]}")
fi

# --- Warning ---

if [[ "$WARNING_ENABLED" == "true" ]]; then
    mapfile -t WARNING_LINES < <(wizard_list \
        "$(_l "Warning lines" "Строки предупреждения")" \
        "$(_l \
"The legal / authorized-access notice. The first line is highlighted." \
"Юридическое предупреждение / уведомление об авторизованном доступе. Первая строка выделяется.")" \
        "${WARNING_LINES[@]}")
fi

# --- System ---

configure_disks_page() {
    local detected=() seen mp existing pre dup mp_entry multi=() selected_mps=()
    # Detect "real" mountpoints — skip pseudo-fs and small ones.
    while IFS= read -r mp; do
        [[ -z "$mp" ]] && continue
        case "$mp" in
            /proc*|/sys*|/dev*|/run*|/snap*|/var/lib/docker/*|/boot/efi*) continue ;;
        esac
        seen=0
        for existing in "${detected[@]}"; do
            [[ "$existing" == "$mp" ]] && seen=1 && break
        done
        (( seen )) || detected+=("$mp")
    done < <(df -P --output=target 2>/dev/null | tail -n +2 | sort -u)

    # Build multiselect: pre-check anything already in SYSTEM_DISK_PATHS.
    for mp in "${detected[@]}"; do
        pre=0
        for existing in "${SYSTEM_DISK_PATHS[@]}"; do
            [[ "$existing" == "$mp" ]] && pre=1 && break
        done
        multi+=("${pre}${mp}")
    done
    # Surface previously-configured paths not detected (rare — mountpoint went away)
    for existing in "${SYSTEM_DISK_PATHS[@]}"; do
        dup=0
        for mp in "${detected[@]}"; do
            [[ "$mp" == "$existing" ]] && dup=1 && break
        done
        (( dup )) || multi+=("1${existing} (missing)")
    done

    SYSTEM_DISK_PATHS=()
    if [[ ${#multi[@]} -gt 0 ]]; then
        mapfile -t selected_mps < <(wizard_multiselect \
            "$(_l "Disk mountpoints to display" "Точки монтирования дисков")" \
            "$(_l \
"Detected from df. Pick mountpoints to display in System status. Each shows '<used> / <total> (<pct>% used)'." \
"Список собран через df. Отметьте точки монтирования для показа в System status. Каждая покажет '<занято> / <всего> (<%> used)'.")" \
            -- "${multi[@]}")
        for mp_entry in "${selected_mps[@]}"; do
            SYSTEM_DISK_PATHS+=("${mp_entry% (*}")
        done
    fi
    [[ ${#SYSTEM_DISK_PATHS[@]} -eq 0 ]] && SYSTEM_DISK_PATHS=("/")
}

if [[ "$SYSTEM_ENABLED" == "true" ]]; then
    configure_disks_page
fi

# --- Services ---

# Wrap in a function so we can use `local` cleanly.
configure_services_page() {
    local candidates=() unit existing found cur c entry state pre in_candidates dup multi=() selected_svcs=() custom_svcs=()

    if command -v systemctl >/dev/null 2>&1; then
        while IFS= read -r unit; do
            unit="${unit%.service}"
            [[ -z "$unit" ]] && continue
            case "$unit" in
                systemd-*|dbus|polkit*|snap.*|snapd*|udev*|user@*|getty@*|*\.scope|init.scope|systemd*|networkd-*|resolved*)
                    continue ;;
                *@.service|*@*) continue ;;
            esac
            found=0
            for existing in "${candidates[@]}"; do
                [[ "$existing" == "$unit" ]] && found=1 && break
            done
            (( found )) || candidates+=("$unit")
        done < <(
            { systemctl list-unit-files --type=service --state=enabled --no-legend --no-pager --plain 2>/dev/null
              systemctl list-units --type=service --state=active --no-legend --no-pager --plain 2>/dev/null
            } | awk '{print $1}' | sort -u
        )
    fi

    for c in "${candidates[@]}"; do
        state=$(systemctl is-active "$c" 2>/dev/null || echo unknown)
        pre=0
        for cur in "${SERVICES_LIST[@]}"; do
            [[ "$cur" == "$c" ]] && pre=1 && break
        done
        multi+=("${pre}${c} (${state})")
    done
    # Surface previously-configured units that aren't in the auto list.
    for cur in "${SERVICES_LIST[@]}"; do
        in_candidates=0
        for c in "${candidates[@]}"; do
            [[ "$cur" == "$c" ]] && in_candidates=1 && break
        done
        (( in_candidates )) || multi+=("1${cur} (custom)")
    done

    SERVICES_LIST=()
    if [[ ${#multi[@]} -gt 0 ]]; then
        mapfile -t selected_svcs < <(wizard_multiselect \
            "$(_l "Pick services to monitor" "Выберите сервисы для отслеживания")" \
            "$(_l \
"Detected from systemctl. Pick everything you want shown on the MOTD; you can add more on the next page if a unit isn't listed." \
"Список собран через systemctl. Отметьте сервисы для показа в MOTD; на следующей странице можно дописать вручную, если чего-то нет.")" \
            -- "${multi[@]}")
        for entry in "${selected_svcs[@]}"; do
            SERVICES_LIST+=("${entry% (*}")
        done
    fi

    mapfile -t custom_svcs < <(wizard_list \
        "$(_l "Additional services" "Дополнительные сервисы")" \
        "$(_l \
"Optional. Add unit names manually (without .service) for anything not auto-detected above. Leave empty to skip." \
"Опционально. Допишите имена юнитов вручную (без .service), если какого-то нет в списке выше. Можно оставить пустым.")" \
        )
    for c in "${custom_svcs[@]}"; do
        dup=0
        for existing in "${SERVICES_LIST[@]}"; do
            [[ "$existing" == "$c" ]] && dup=1 && break
        done
        (( dup )) || SERVICES_LIST+=("$c")
    done

    [[ ${#SERVICES_LIST[@]} -eq 0 ]] && SERVICES_ENABLED=false
}

if [[ "$SERVICES_ENABLED" == "true" ]]; then
    configure_services_page
fi

# --- SSL ---

if [[ "$SSL_ENABLED" == "true" ]]; then
    if wizard_yesno \
        "$(_l "Auto-discover Let's Encrypt certs?" "Авто-поиск Let's Encrypt сертификатов?")" \
        "$(_l \
"Look in /etc/letsencrypt/live/* and report expiry days for each cert found. Recommended if you use Certbot." \
"Сканирует /etc/letsencrypt/live/* и показывает дни до истечения каждого найденного сертификата. Рекомендуется если используется Certbot.")" \
        "$([[ "$SSL_AUTODISCOVER_LETSENCRYPT" == "true" ]] && echo y || echo n)"; then
        SSL_AUTODISCOVER_LETSENCRYPT=true
    else
        SSL_AUTODISCOVER_LETSENCRYPT=false
    fi

    mapfile -t SSL_DOMAINS < <(wizard_list \
        "$(_l "Additional SSL targets" "Дополнительные SSL-цели")" \
        "$(_l \
"Optional. Each entry can be:
  · 'example.com'         — remote check on port 443
  · 'example.com:8443'    — remote check on custom port
  · '/path/to/cert.pem'   — local PEM file" \
"Опционально. Каждая строка может быть:
  · 'example.com'         — удалённая проверка на порту 443
  · 'example.com:8443'    — удалённая проверка на нестандартном порту
  · '/path/to/cert.pem'   — локальный PEM-файл")" \
        "${SSL_DOMAINS[@]}")

    SSL_WARN_DAYS=$(wizard_text \
        "$(_l "SSL warning threshold" "Порог предупреждения для SSL")" \
        "$(_l \
"Number of days before expiry that should trigger a yellow warning." \
"За сколько дней до истечения сертификата показывать жёлтое предупреждение.")" \
        "$SSL_WARN_DAYS")
fi

# --- Network ---

if [[ "$NETWORK_ENABLED" == "true" ]]; then
    if wizard_yesno \
        "$(_l "Show public IP?" "Показывать публичный IP?")" \
        "$(_l \
"Calls api.ipify.org (cached for 5 min). Disable on air-gapped hosts." \
"Запрашивает api.ipify.org (кешируется на 5 мин). Отключите на изолированных серверах.")" \
        "$([[ "$NETWORK_SHOW_PUBLIC_IP" == "true" ]] && echo y || echo n)"; then
        NETWORK_SHOW_PUBLIC_IP=true
    else
        NETWORK_SHOW_PUBLIC_IP=false
    fi
fi

# --- Docker filter ---

if [[ "$DOCKER_ENABLED" != "false" ]]; then
    DOCKER_FILTER=$(wizard_text \
        "$(_l "Docker name filter" "Фильтр имён Docker-контейнеров")" \
        "$(_l \
"Optional regex to limit which containers are listed by name (e.g. '^web|^api'). Leave blank for all." \
"Опциональный regex для фильтрации контейнеров по имени (например '^web|^api'). Пусто = все.")" \
        "$DOCKER_FILTER")
fi

# --- Directories ---

if [[ "$DIRECTORIES_ENABLED" == "true" ]]; then
    mapfile -t DIRECTORIES_LIST < <(wizard_list \
        "$(_l "Monitored directories" "Отслеживаемые каталоги")" \
        "$(_l \
"Show 'du -sh' for each path (cached for 5 min). Format: Label|/absolute/path (e.g. Backups|/srv/backups)." \
"Показывает 'du -sh' для каждого пути (кешируется на 5 мин). Формат: Label|/absolute/path (например Backups|/srv/backups).")" \
        "${DIRECTORIES_LIST[@]}")
    [[ ${#DIRECTORIES_LIST[@]} -eq 0 ]] && DIRECTORIES_ENABLED=false
fi

# --- Last logins ---

if [[ "$LASTLOGIN_ENABLED" == "true" ]]; then
    LASTLOGIN_COUNT=$(wizard_text \
        "$(_l "Recent logins to show" "Сколько недавних логинов показывать")" \
        "$(_l \
"How many of the most recent successful logins to display." \
"Сколько последних успешных логинов отображать.")" \
        "$LASTLOGIN_COUNT")
fi

# --- Weather ---

if [[ "$WEATHER_ENABLED" == "true" ]]; then
    WEATHER_CITY=$(wizard_text \
        "$(_l "City for weather" "Город для погоды")" \
        "$(_l \
"Used by wttr.in. Leave blank to auto-detect by IP. Examples: 'Berlin', 'New York', 'Tokyo'." \
"Используется wttr.in. Пусто = автоопределение по IP. Примеры: 'Berlin', 'Москва', 'Tokyo'.")" \
        "$WEATHER_CITY")
fi

# ---------- write config ----------

mkdir -p "$SMART_MOTD_CONFIG_DIR"
TS=$(date '+%Y-%m-%d %H:%M:%S')

{
    echo "# smart-motd configuration"
    echo "# Generated by 'smart-motd setup' at $TS"
    echo "# Re-run 'sudo smart-motd setup' to reconfigure, or edit this file directly."
    echo
    echo "# ---- Theme ----"
    echo "THEME=$(qstr "$THEME")"
    echo "COLOR_THEME=$(qstr "$COLOR_THEME")"
    # Save the resolved theme variables as well, so per-variable user overrides
    # (e.g. KV separator) survive even if the named theme's default differs.
    echo "THEME_BANNER_CHAR=$(qstr "${THEME_BANNER_CHAR}")"
    echo "THEME_DIVIDER_CHAR=$(qstr "${THEME_DIVIDER_CHAR}")"
    echo "THEME_KV_SEPARATOR=$(qstr "${THEME_KV_SEPARATOR}")"
    echo "THEME_HEADING_STYLE=$(qstr "${THEME_HEADING_STYLE}")"
    echo
    echo "# ---- Header ----"
    echo "HEADER_TEXT=$(qstr "$HEADER_TEXT")"
    echo "HEADER_SPACED=$HEADER_SPACED"
    echo
    echo "# ---- Welcome ----"
    echo "WELCOME_TITLE=$(qstr "$WELCOME_TITLE")"
    write_array WELCOME_LINES "${WELCOME_LINES[@]}"
    echo
    echo "# ---- Warning ----"
    write_array WARNING_LINES "${WARNING_LINES[@]}"
    echo
    echo "# ---- System status ----"
    write_array SYSTEM_DISK_PATHS "${SYSTEM_DISK_PATHS[@]}"
    echo
    echo "# ---- Services ----"
    write_array SERVICES_LIST "${SERVICES_LIST[@]}"
    echo
    echo "# ---- Network ----"
    echo "NETWORK_SHOW_PUBLIC_IP=$NETWORK_SHOW_PUBLIC_IP"
    echo
    echo "# ---- SSL ----"
    echo "SSL_AUTODISCOVER_LETSENCRYPT=$SSL_AUTODISCOVER_LETSENCRYPT"
    write_array SSL_DOMAINS "${SSL_DOMAINS[@]}"
    echo "SSL_WARN_DAYS=$SSL_WARN_DAYS"
    echo
    echo "# ---- Containers ----"
    echo "DOCKER_FILTER=$(qstr "$DOCKER_FILTER")"
    echo
    echo "# ---- Directories ----"
    write_array DIRECTORIES_LIST "${DIRECTORIES_LIST[@]}"
    echo
    echo "# ---- Last logins ----"
    echo "LASTLOGIN_COUNT=$LASTLOGIN_COUNT"
    echo
    echo "# ---- Weather ----"
    echo "WEATHER_CITY=$(qstr "$WEATHER_CITY")"
    echo
    echo "# ---- Colors ----"
    echo "COLORS_ENABLED=$COLORS_ENABLED"
    echo
    echo "# ---- Section toggles ----"
    for s in HEADER WELCOME WARNING SYSTEM MAINTENANCE UPDATES SERVICES NETWORK SSL \
             SECURITY TEMPERATURE SMART DOCKER PODMAN KUBERNETES DIRECTORIES \
             LASTLOGIN WEATHER FOOTER; do
        var="${s}_ENABLED"
        echo "${var}=${!var}"
    done
} >"$SMART_MOTD_CONFIG"

chmod 0644 "$SMART_MOTD_CONFIG"

# ---------- prime cache ----------

_wiz_clear
printf '\n  \e[1;32m✓ %s\e[0m %s\n\n' \
    "$(_l "Configuration saved" "Конфиг сохранён")" "$SMART_MOTD_CONFIG"
printf '  %s\n' "$(_l "Priming cache (this may take a few seconds)…" "Прогреваю кеш (займёт пару секунд)…")"
"${SMART_MOTD_PREFIX}/bin/motd-cache-update" || true
printf '  \e[1;32m✓ %s\e[0m\n\n' "$(_l "Cache primed" "Кеш прогрет")"

# ---------- preview ----------

if wizard_yesno \
    "$(_l "Show preview now?" "Показать превью прямо сейчас?")" \
    "$(_l "Render the MOTD with your new settings to verify everything looks right." "Отрисовать MOTD с новыми настройками для проверки.")" y; then
    _wiz_clear
    printf '\n'
    SMART_MOTD_FORCE_COLOR=1 "${SMART_MOTD_PREFIX}/bin/motd-generate"
    printf '\n  \e[2m(%s)\e[0m ' "$(_l "Press Enter to exit" "Нажмите Enter чтобы выйти")"
    read -r _ </dev/tty
fi

wizard_done \
    "$(_l "All done" "Готово")" \
    "$(_l \
"smart-motd will now render this on every login.

Useful commands:
  smart-motd show         · preview the MOTD any time
  sudo smart-motd setup   · re-run this wizard
  sudo smart-motd edit    · edit the raw config
  sudo smart-motd uninstall

Config: $SMART_MOTD_CONFIG

────────────────────────────────────────────
Enjoying smart-motd? Star it on GitHub:
https://github.com/erneywhite/smart-motd
by @erneywhite" \
"smart-motd теперь будет показывать это при каждом логине.

Полезные команды:
  smart-motd show         · просмотреть MOTD в любой момент
  sudo smart-motd setup   · перезапустить визард
  sudo smart-motd edit    · отредактировать конфиг напрямую
  sudo smart-motd uninstall

Конфиг: $SMART_MOTD_CONFIG

────────────────────────────────────────────
Нравится smart-motd? Поставь звезду на GitHub:
https://github.com/erneywhite/smart-motd
by @erneywhite")"
