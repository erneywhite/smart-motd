    if wizard_yesno \
        "$(_l "Auto-discover Let's Encrypt certs?" "Авто-поиск Let's Encrypt сертификатов?")" \
        "$(_l \
"Look in /etc/letsencrypt/live/* and report expiry days for each cert found. Recommended if you use Certbot." \
"Сканирует /etc/letsencrypt/live/* и показывает дни до истечения каждого найденного сертификата. Рекомендуется если используется Certbot.")" \
        "$([[ "$SSL_AUTODISCOVER_LETSENCRYPT" == "true" ]] && echo y || echo n)"; then
        SSL_AUTODISCOVER_LETSENCRYPT=true
    else
        SSL_AUTODISCOVER_LETSENCRYPT=false
    fi

    mapfile -t SSL_DOMAINS < <(wizard_list \
        "$(_l "Additional SSL targets" "Дополнительные SSL-цели")" \
        "$(_l \
"Optional. Each entry can be:
  · 'example.com'         — remote check on port 443
  · 'example.com:8443'    — remote check on custom port
  · '/path/to/cert.pem'   — local PEM file" \
"Опционально. Каждая строка может быть:
  · 'example.com'         — удалённая проверка на порту 443
  · 'example.com:8443'    — удалённая проверка на нестандартном порту
  · '/path/to/cert.pem'   — локальный PEM-файл")" \
        "${SSL_DOMAINS[@]}")

    SSL_WARN_DAYS=$(wizard_text \
        "$(_l "SSL warning threshold" "Порог предупреждения для SSL")" \
        "$(_l \
"Number of days before expiry that should trigger a yellow warning." \
"За сколько дней до истечения сертификата показывать жёлтое предупреждение.")" \
        "$SSL_WARN_DAYS")
fi

# --- Network ---

configure_network_page() {
    local detected=() iface mp existing pre dup multi=() selected_ifaces=()

    # Public IP toggle
    if wizard_yesno \
        "$(_l "Show public IP?" "Показывать публичный IP?")" \
        "$(_l \
"Calls api.ipify.org (cached for 5 min). Disable on air-gapped hosts." \
"Запрашивает api.ipify.org (кешируется на 5 мин). Отключите на изолированных серверах.")" \
        "$([[ "$NETWORK_SHOW_PUBLIC_IP" == "true" ]] && echo y || echo n)"; then
        NETWORK_SHOW_PUBLIC_IP=true
    else
        NETWORK_SHOW_PUBLIC_IP=false
    fi

    # Internal interfaces toggle
    if ! wizard_yesno \
        "$(_l "Show internal interface IPs?" "Показывать IP внутренних интерфейсов?")" \
        "$(_l \
"Lists each network interface's IPv4 address (eth0, ens18, wg0, docker0, …). Useful for checking which IP a server is reachable on internally." \
"Покажет IPv4-адрес каждого интерфейса (eth0, ens18, wg0, docker0, …). Удобно чтобы понять по какому IP сервер доступен в локалке.")" \
        "$([[ "${NETWORK_SHOW_INTERFACES:-true}" == "true" ]] && echo y || echo n)"; then
        NETWORK_SHOW_INTERFACES=false
        NETWORK_INTERFACES=()
        return
    fi
    NETWORK_SHOW_INTERFACES=true

    # Detect interfaces. Skip loopback.
    if command -v ip >/dev/null 2>&1; then
        while IFS= read -r iface; do
            [[ -z "$iface" || "$iface" == "lo" ]] && continue
            local seen=0 e
            for e in "${detected[@]}"; do
                [[ "$e" == "$iface" ]] && seen=1 && break
            done
            (( seen )) || detected+=("$iface")
        done < <(ip -o -4 addr show 2>/dev/null | awk '{print $2}' | sort -u)
    fi

    # Build multiselect entries.
    # Special "All interfaces" first entry maps to NETWORK_INTERFACES=()
    # (i.e. show every detected one).
    multi=()
    local all_pre=1
    [[ ${#NETWORK_INTERFACES[@]} -gt 0 ]] && all_pre=0
    multi+=("${all_pre}$(_l "All interfaces (auto)" "Все интерфейсы (автоматически)")")
    local i
    for i in "${detected[@]}"; do
        # IP for context
        local ip_for_iface
        ip_for_iface=$(ip -o -4 addr show "$i" 2>/dev/null | awk 'NR==1 {split($4,a,"/"); print a[1]}')
        pre=0
        for e in "${NETWORK_INTERFACES[@]}"; do
            [[ "$e" == "$i" ]] && pre=1 && break
        done
        # If "All" is checked, leave the per-iface checkboxes off — they only
        # matter when the operator wants a specific subset.
        if (( all_pre )); then pre=0; fi
        multi+=("${pre}${i} (${ip_for_iface:-no IPv4})")
    done

    if [[ ${#multi[@]} -le 1 ]]; then
        # No interfaces detected — skip the multiselect entirely.
        NETWORK_INTERFACES=()
        return
    fi

    mapfile -t selected_ifaces < <(wizard_multiselect \
        "$(_l "Pick interfaces to display" "Выберите интерфейсы для показа")" \
        "$(_l \
"Pick 'All interfaces (auto)' to always show every non-loopback interface — recommended unless you specifically want to hide some (e.g. docker0). If 'All' is unchecked, only the explicitly-checked interfaces are shown." \
"Выберите 'Все интерфейсы (автоматически)', чтобы показывать каждый non-loopback интерфейс — это рекомендуемый вариант, если только не нужно специально скрыть какие-то (например docker0). Если 'Все' не отмечено — будут показаны только явно выбранные.")" \
        -- "${multi[@]}")

    NETWORK_INTERFACES=()
    local picked_all=false
    for entry in "${selected_ifaces[@]}"; do
        case "$entry" in
            "All interfaces (auto)"|"Все интерфейсы (автоматически)")
                picked_all=true
                ;;
            *)
                # strip trailing " (ip)" suffix to recover bare iface name
                NETWORK_INTERFACES+=("${entry% (*}")
                ;;
        esac
    done
    if $picked_all; then
        NETWORK_INTERFACES=()  # empty = show all
    fi

    # Optionally append rx/tx rate next to each IP.
    if wizard_yesno \
        "$(_l "Show rx/tx rate next to each interface?" "Показывать rx/tx-скорость рядом с каждым интерфейсом?")" \
        "$(_l \
"Adds a 5-minute averaged byte rate after each IP (e.g. 'eth0: 10.0.0.5  rx 12.3 KB/s  tx 4.5 KB/s'). The rate is computed from /sys/class/net counters at every cache refresh, so it appears one tick after fresh installs." \
"Добавляет к каждому IP среднюю скорость за 5 минут (например 'eth0: 10.0.0.5  rx 12.3 KB/s  tx 4.5 KB/s'). Считается из /sys/class/net на каждом обновлении кеша, поэтому после свежей установки появляется через один цикл (~5 мин).")" \
        "$([[ "${NETWORK_SHOW_RATES:-true}" == "true" ]] && echo y || echo n)"; then
        NETWORK_SHOW_RATES=true
    else
        NETWORK_SHOW_RATES=false
    fi
}

if [[ "$NETWORK_ENABLED" == "true" ]]; then
    configure_network_page
fi

