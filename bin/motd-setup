# --- Telegram SSH login alerts ---

configure_telegram_alerts_page() {
    # Gate the credential prompts behind a yes/no when creds already exist.
    # Default is "no" so a re-run of the wizard doesn't accidentally wipe
    # the bot token by mashing Enter through pre-filled fields.
    local edit_creds=true
    if [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
        if ! wizard_yesno \
            "$(_l "Edit Telegram credentials?" "Изменить Telegram-креды?")" \
            "$(_l \
"Bot token + chat ID are already saved (from a previous setup run).

Pick 'No' to keep them as-is and skip ahead to the language picker / test send (recommended if you just want to verify alerts still work or change the message language).

Pick 'Yes' to be re-prompted for bot token, chat ID and thread ID. Existing values will be pre-filled — hit Enter on each to keep, or type a new value to overwrite." \
"Токен бота и chat ID уже сохранены (с прошлого запуска визарда).

Выберите 'Нет' чтобы оставить их как есть и перейти к выбору языка / тестовой отправке (рекомендуется если просто хотите убедиться что алерты работают, или сменить язык сообщений).

Выберите 'Да' чтобы перенабрать токен, chat ID и thread ID. Существующие значения подставятся — Enter чтобы оставить, или введите новое чтобы перезаписать.")" \
            n; then
            edit_creds=false
        fi
    fi

    if $edit_creds; then
        TELEGRAM_BOT_TOKEN=$(wizard_text \
            "$(_l "Telegram bot token" "Токен Telegram-бота")" \
            "$(_l \
"Create a bot via @BotFather, paste the API token here. Looks like '1234567:abc...'. Stored in /etc/smart-motd/secrets.conf with mode 0600 (root-only)." \
"Создайте бота через @BotFather и вставьте API-токен сюда. Выглядит как '1234567:abc...'. Хранится в /etc/smart-motd/secrets.conf с правами 0600 (только root).")" \
            "$TELEGRAM_BOT_TOKEN")

        # Destination type — derived from current TELEGRAM_CHAT_ID's sign
        # (negative = group/channel, positive/blank = personal). On re-run
        # the cursor lands on the existing choice.
        local dest_default=0 dest_choice
        [[ "$TELEGRAM_CHAT_ID" == -* ]] && dest_default=1
        dest_choice=$(wizard_select \
            "$(_l "Where should the alerts go?" "Куда отправлять алерты?")" \
            "$(_l \
"Personal chat = bot DMs you directly (you must /start the bot first). Group/channel = bot posts to a shared chat (bot must be added there as a member)." \
"Личный чат = бот пишет лично вам в ЛС (нужно сначала отправить ему /start). Группа/канал = бот публикует в общем чате (бота нужно туда добавить).")" \
            "$dest_default" -- \
            "$(_l "Personal chat (DM)" "Личный чат (ЛС)")" \
            "$(_l "Group / channel" "Группа / канал")")

        local is_group=false
        case "$dest_choice" in
            *Group*|*Группа*) is_group=true ;;
        esac

        if $is_group; then
            TELEGRAM_CHAT_ID=$(wizard_text \
                "$(_l "Group / channel ID" "ID группы / канала")" \
                "$(_l \
"Negative numeric ID of the group or channel where alerts will be posted. Looks like '-1001234567890' for super-groups/channels, or '-123456789' for plain groups. Make sure the bot is added to the group as a member (channels need it as admin to post). To find the ID: add @userinfobot to the group, send /start, it replies with the group's ID." \
"Отрицательный числовой ID группы или канала, куда полетят алерты. Выглядит как '-1001234567890' для супергрупп/каналов или '-123456789' для обычных групп. Бот должен быть добавлен в группу как участник (для каналов — админом, чтобы постить). Узнать ID: добавьте @userinfobot в группу, отправьте /start, он напишет ID.")" \
                "$TELEGRAM_CHAT_ID")

            TELEGRAM_THREAD_ID=$(wizard_text \
                "$(_l "Thread ID (optional, only for groups with topics)" "Thread ID (опционально, только для групп с темами)")" \
                "$(_l \
"If your group has Topics enabled, paste the thread ID to send alerts to a specific topic. Leave blank to post to the main thread / 'General'." \
"Если в группе включены темы — впишите ID треда, чтобы алерты шли в конкретную тему. Пусто = в основной чат / 'General'.")" \
                "$TELEGRAM_THREAD_ID")
        else
            TELEGRAM_CHAT_ID=$(wizard_text \
                "$(_l "Your personal Telegram user ID" "Ваш личный Telegram user ID")" \
                "$(_l \
"Positive numeric ID of YOUR Telegram account. The bot DMs you at this ID. IMPORTANT: open the bot in Telegram and press /start at least once — bots can't initiate DMs to users who haven't started the conversation. To find your ID: send /start to @userinfobot, it replies with your numeric user ID." \
"Положительный числовой ID ВАШЕГО Telegram-аккаунта. Бот будет писать вам в ЛС по этому ID. ВАЖНО: откройте бота в Telegram и хотя бы раз нажмите /start — бот не может начать переписку с пользователем, который сам ему не написал. Узнать свой ID: отправьте /start боту @userinfobot, он вернёт ваш ID.")" \
                "$TELEGRAM_CHAT_ID")
            # Personal chats don't have threads — clear any stale value.
            TELEGRAM_THREAD_ID=""
        fi
    fi

    # Alert language picker (separate from wizard language).
    local lang_default=0
    [[ "${TELEGRAM_ALERTS_LANG:-${WIZ_LANG}}" == "ru" ]] && lang_default=1
    local lang_choice
    lang_choice=$(wizard_select \
        "$(_l "Alert message language" "Язык сообщений-алертов")" \
        "$(_l \
"Language used in the SSH-login alert messages themselves. Independent from the wizard language above (some operators run setup in English but want Russian alerts because their team chat is in Russian, or vice versa)." \
"Язык, на котором будут приходить уведомления о входе. Не зависит от языка визарда (некоторые админы предпочитают настраивать на английском, а уведомления получать на русском — например в чат с командой).")" \
        "$lang_default" -- \
        "English" "Русский")
    case "$lang_choice" in
        "Русский") TELEGRAM_ALERTS_LANG=ru ;;
        *)         TELEGRAM_ALERTS_LANG=en ;;
    esac

    # IP whitelist — silently skip alerts for known-good source IPs/ranges.
    mapfile -t TELEGRAM_ALERTS_IP_WHITELIST < <(wizard_list \
        "$(_l "Whitelist of source IPs (no alert when matched)" "Белый список IP (для них алерт НЕ шлётся)")" \
        "$(_l \
"Optional. Each entry is either a single IPv4 or a CIDR block. Logins from these addresses won't trigger an alert — useful for your own home/office IP or a VPN range.

Examples:
  203.0.113.5          (single IP)
  192.168.1.0/24       (whole subnet)
  10.0.0.0/8           (private range)

Leave empty to alert on every login." \
"Опционально. Каждая запись — либо один IPv4, либо CIDR-блок. Входы с этих адресов НЕ вызовут алерт — удобно для своего домашнего/офисного IP или VPN-подсети.

Примеры:
  203.0.113.5          (один IP)
  192.168.1.0/24       (вся подсеть)
  10.0.0.0/8           (приватный диапазон)

Пусто = слать на каждый вход.")" \
        "${TELEGRAM_ALERTS_IP_WHITELIST[@]}")

    # Daily recap toggle — opt-in, off by default.
    if wizard_yesno \
        "$(_l "Enable daily recap?" "Включить ежедневную сводку?")" \
        "$(_l \
"Optional. Sends one message per day to the same chat with a summary: total SSH logins in the last 24h, failed-auth count, pending package updates, reboot-required status. Independent from per-login alerts." \
"Опционально. Раз в сутки шлёт в тот же чат сводку: количество входов за 24ч, неудачные попытки, доступные обновления пакетов, нужна ли перезагрузка. Не зависит от алертов на каждый логин.")" \
        "$([[ "${TELEGRAM_RECAP_ENABLED:-false}" == "true" ]] && echo y || echo n)"; then
        TELEGRAM_RECAP_ENABLED=true
        TELEGRAM_RECAP_HOUR=$(wizard_text \
            "$(_l "Hour of day to send recap (0-23, server local time)" "Час отправки сводки (0-23, локальное время сервера)")" \
            "$(_l \
"24-hour clock, server's timezone. E.g. 9 = 9:00 AM. Recap is fired by the cache timer when the hour matches." \
"24-часовой формат, часовой пояс сервера. Например 9 = 9:00 утра. Сводка отправляется cache-таймером при совпадении часа.")" \
            "${TELEGRAM_RECAP_HOUR:-9}")
    else
        TELEGRAM_RECAP_ENABLED=false
    fi

    # Test send right here, before save — so the operator sees it work
    # before committing the config to disk.
    if wizard_yesno \
        "$(_l "Send a test message now?" "Отправить тестовое сообщение прямо сейчас?")" \
        "$(_l \
"Calls api.telegram.org with the token+chat above and shows the result. Recommended — verifies the credentials work before the config is saved." \
"Запросит api.telegram.org с введёнными токеном и chat_id и покажет результат. Рекомендуется — убедитесь что креды работают до сохранения конфига.")" \
        y; then
        local short_host test_msg url response rc
        short_host=$(hostname -s 2>/dev/null || hostname)
        if [[ "$TELEGRAM_ALERTS_LANG" == "ru" ]]; then
            test_msg="✅ smart-motd: тестовое сообщение с ${short_host} (отправлено из визарда настройки)"
        else
            test_msg="✅ smart-motd: test message from ${short_host} (sent from the setup wizard)"
        fi
        url="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage"
        local args=(
            --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}"
            --data-urlencode "text=${test_msg}"
        )
        [[ -n "$TELEGRAM_THREAD_ID" ]] && args+=( --data-urlencode "message_thread_id=${TELEGRAM_THREAD_ID}" )
        response=$(curl -fsS --max-time 8 "${args[@]}" "$url" 2>&1) && rc=0 || rc=$?

        if (( rc == 0 )) && [[ "$response" == *'"ok":true'* ]]; then
            wizard_intro \
                "$(_l "✓ Test message sent" "✓ Тестовое сообщение отправлено")" \
                "$(_l \
"Check your Telegram chat — the message should already be there. The wizard will save the config on the next page." \
"Проверьте Telegram-чат — сообщение уже должно быть. Визард сохранит конфиг на следующей странице.")"
        else
            wizard_intro \
                "$(_l "✗ Test message failed" "✗ Тестовое сообщение не отправилось")" \
                "$(_l \
"Telegram API didn't accept the message. Response from the API:

${response}

Common causes: wrong bot token, wrong chat ID (groups/channels need negative numbers prefixed with -100…), bot not added to the chat, thread ID for a group without topics enabled.

The wizard will save the config anyway — re-run setup to fix." \
"Telegram API не принял сообщение. Ответ API:

${response}

Типичные причины: неверный токен бота, неверный chat ID (для групп/каналов нужны отрицательные числа с префиксом -100…), бот не добавлен в чат, thread ID указан для группы без включённых тем.

Визард всё равно сохранит конфиг — перезапустите setup чтобы поправить.")"
        fi
    fi
}

if [[ "$TELEGRAM_ALERTS_ENABLED" == "true" ]]; then
    configure_telegram_alerts_page
fi

# ---------- write config ----------

mkdir -p "$SMART_MOTD_CONFIG_DIR"
TS=$(date '+%Y-%m-%d %H:%M:%S')

{
    echo "# smart-motd configuration"
    echo "# Generated by 'smart-motd setup' at $TS"
    echo "# Re-run 'sudo smart-motd setup' to reconfigure, or edit this file directly."
    echo
    echo "# ---- Wizard ----"
    echo "# Language used in the setup wizard prompts (en / ru). Re-runs of"
    echo "# the wizard pre-select this language but you can change it on the"
    echo "# first page each time. Doesn't affect the rendered MOTD."
    echo "WIZ_LANG=$(qstr "${WIZ_LANG:-en}")"
    echo
    echo "# ---- Theme ----"
    echo "THEME=$(qstr "$THEME")"
    echo "COLOR_THEME=$(qstr "$COLOR_THEME")"
    # Save the resolved theme variables as well, so per-variable user overrides
    # (e.g. KV separator) survive even if the named theme's default differs.
    echo "THEME_BANNER_CHAR=$(qstr "${THEME_BANNER_CHAR}")"
    echo "THEME_DIVIDER_CHAR=$(qstr "${THEME_DIVIDER_CHAR}")"
    echo "THEME_KV_SEPARATOR=$(qstr "${THEME_KV_SEPARATOR}")"
    echo "THEME_HEADING_STYLE=$(qstr "${THEME_HEADING_STYLE}")"
    echo
    echo "# ---- Header ----"
    echo "HEADER_TEXT=$(qstr "$HEADER_TEXT")"
    echo "HEADER_SPACED=$HEADER_SPACED"
    echo
    echo "# ---- Welcome ----"
    echo "WELCOME_TITLE=$(qstr "$WELCOME_TITLE")"
    write_array WELCOME_LINES "${WELCOME_LINES[@]}"
    echo
    echo "# ---- Warning ----"
    write_array WARNING_LINES "${WARNING_LINES[@]}"
    echo
    echo "# ---- System status ----"
    write_array SYSTEM_DISK_PATHS "${SYSTEM_DISK_PATHS[@]}"
    echo
    echo "# ---- Services ----"
    write_array SERVICES_LIST "${SERVICES_LIST[@]}"
    echo
    echo "# ---- Network ----"
    echo "NETWORK_SHOW_PUBLIC_IP=$NETWORK_SHOW_PUBLIC_IP"
    echo "NETWORK_SHOW_INTERFACES=${NETWORK_SHOW_INTERFACES:-true}"
    echo "NETWORK_SHOW_RATES=${NETWORK_SHOW_RATES:-true}"
    write_array NETWORK_INTERFACES "${NETWORK_INTERFACES[@]}"
    echo
    echo "# ---- SSL ----"
    echo "SSL_AUTODISCOVER_LETSENCRYPT=$SSL_AUTODISCOVER_LETSENCRYPT"
    write_array SSL_DOMAINS "${SSL_DOMAINS[@]}"
    echo "SSL_WARN_DAYS=$SSL_WARN_DAYS"
    echo
    echo "# ---- Containers ----"
    echo "DOCKER_FILTER=$(qstr "$DOCKER_FILTER")"
    echo
    echo "# ---- Directories ----"
    write_array DIRECTORIES_LIST "${DIRECTORIES_LIST[@]}"
    echo
    echo "# ---- Last logins ----"
    echo "LASTLOGIN_COUNT=$LASTLOGIN_COUNT"
    echo
    echo "# ---- Weather ----"
    echo "WEATHER_CITY=$(qstr "$WEATHER_CITY")"
    echo
    echo "# ---- Telegram SSH alerts ----"
    echo "# Bot token / chat ID / thread ID live in secrets.conf (root-only)."
    echo "TELEGRAM_ALERTS_LANG=$(qstr "${TELEGRAM_ALERTS_LANG:-en}")"
    write_array TELEGRAM_ALERTS_IP_WHITELIST "${TELEGRAM_ALERTS_IP_WHITELIST[@]}"
    echo "TELEGRAM_RECAP_ENABLED=${TELEGRAM_RECAP_ENABLED:-false}"
    echo "TELEGRAM_RECAP_HOUR=${TELEGRAM_RECAP_HOUR:-9}"
    echo
    echo "# ---- Colors ----"
    echo "COLORS_ENABLED=$COLORS_ENABLED"
    echo
    echo "# ---- Section toggles ----"
    for s in HEADER WELCOME WARNING SYSTEM MAINTENANCE UPDATES SERVICES NETWORK SSL \
             SECURITY TEMPERATURE SMART DOCKER PODMAN KUBERNETES VPN NTP RAID \
             DIRECTORIES LASTLOGIN WEATHER TELEGRAM_ALERTS FOOTER; do
        var="${s}_ENABLED"
        echo "${var}=${!var}"
    done
} >"$SMART_MOTD_CONFIG"

chmod 0644 "$SMART_MOTD_CONFIG"

# Secrets file lives separately at mode 0600 so the bot token isn't
# world-readable in /etc/smart-motd/config.conf.
SMART_MOTD_SECRETS="${SMART_MOTD_CONFIG_DIR}/secrets.conf"
{
    echo "# smart-motd secrets — sensitive credentials, mode 0600"
    echo "# Generated by 'smart-motd setup' at $TS"
    echo
    echo "TELEGRAM_BOT_TOKEN=$(qstr "${TELEGRAM_BOT_TOKEN:-}")"
    echo "TELEGRAM_CHAT_ID=$(qstr "${TELEGRAM_CHAT_ID:-}")"
    echo "TELEGRAM_THREAD_ID=$(qstr "${TELEGRAM_THREAD_ID:-}")"
} >"$SMART_MOTD_SECRETS"
chmod 0600 "$SMART_MOTD_SECRETS"

# ---------- prime cache ----------

_wiz_clear
printf '\n  \e[1;32m✓ %s\e[0m %s\n\n' \
    "$(_l "Configuration saved" "Конфиг сохранён")" "$SMART_MOTD_CONFIG"
printf '  %s\n' "$(_l "Priming cache (this may take a few seconds)…" "Прогреваю кеш (займёт пару секунд)…")"
"${SMART_MOTD_PREFIX}/bin/motd-cache-update" || true
printf '  \e[1;32m✓ %s\e[0m\n\n' "$(_l "Cache primed" "Кеш прогрет")"

# ---------- preview ----------

if wizard_yesno \
    "$(_l "Show preview now?" "Показать превью прямо сейчас?")" \
    "$(_l "Render the MOTD with your new settings to verify everything looks right." "Отрисовать MOTD с новыми настройками для проверки.")" y; then
    _wiz_clear
    printf '\n'
    SMART_MOTD_FORCE_COLOR=1 "${SMART_MOTD_PREFIX}/bin/motd-generate"
    printf '\n  \e[2m(%s)\e[0m ' "$(_l "Press Enter to exit" "Нажмите Enter чтобы выйти")"
    read -r _ </dev/tty
fi

wizard_done \
    "$(_l "All done" "Готово")" \
    "$(_l \
"smart-motd will now render this on every login.

Useful commands:
  smart-motd show         · preview the MOTD any time
  sudo smart-motd setup   · re-run this wizard
  sudo smart-motd edit    · edit the raw config
  sudo smart-motd uninstall

Config: $SMART_MOTD_CONFIG

────────────────────────────────────────────
Enjoying smart-motd? Star it on GitHub:
https://github.com/erneywhite/smart-motd
by @erneywhite" \
"smart-motd теперь будет показывать это при каждом логине.

Полезные команды:
  smart-motd show         · просмотреть MOTD в любой момент
  sudo smart-motd setup   · перезапустить визард
  sudo smart-motd edit    · отредактировать конфиг напрямую
  sudo smart-motd uninstall

Конфиг: $SMART_MOTD_CONFIG

────────────────────────────────────────────
Нравится smart-motd? Поставь звезду на GitHub:
https://github.com/erneywhite/smart-motd
by @erneywhite")"
