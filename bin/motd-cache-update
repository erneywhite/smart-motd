#!/usr/bin/env bash
# smart-motd: refresh cached values. Run periodically (systemd timer or cron).
#
# Safe to run as root or as the motd user; just needs write access to the cache dir.

set -u

SMART_MOTD_PREFIX="${SMART_MOTD_PREFIX:-/usr/local/lib/smart-motd}"
SMART_MOTD_CONFIG="${SMART_MOTD_CONFIG:-/etc/smart-motd/config.conf}"

# Defaults so referenced vars are always set.
SSL_AUTODISCOVER_LETSENCRYPT=true
SSL_DOMAINS=()
SSL_WARN_DAYS=14
WEATHER_ENABLED=false
WEATHER_CITY=""
DIRECTORIES_ENABLED=false
DIRECTORIES_LIST=()
SMART_ENABLED=auto
SMART_DISKS=()
COLORS_ENABLED=true

if [[ -r "$SMART_MOTD_CONFIG" ]]; then
    # shellcheck disable=SC1090
    . "$SMART_MOTD_CONFIG"
fi

# shellcheck source=../lib/cache.sh
. "${SMART_MOTD_PREFIX}/lib/cache.sh"

cache_update_all

# Refresh pam_motd's dynamic cache (Debian/Ubuntu).
# pam_motd reads /run/motd.dynamic at login; without this, changes to our
# config and freshly-cached values aren't reflected until pam_motd's own
# refresh schedule (which often skips many logins). Regenerate it from
# /etc/update-motd.d/ ourselves so the next login is always current.
if [[ -d /etc/update-motd.d ]] && [[ -d /run ]] && command -v run-parts >/dev/null 2>&1; then
    SMART_MOTD_FORCE_COLOR=1 run-parts /etc/update-motd.d/ >/run/motd.dynamic 2>/dev/null || true
fi
