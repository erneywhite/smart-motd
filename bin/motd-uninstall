#!/usr/bin/env bash
# smart-motd: remove all installed pieces.

set -u

PREFIX="/usr/local/lib/smart-motd"
BIN_DIR="/usr/local/bin"
CONFIG_DIR="/etc/smart-motd"
CACHE_DIR="/var/cache/smart-motd"

if [[ "$EUID" -ne 0 ]]; then
    echo "smart-motd uninstall must be run as root." >&2
    exit 1
fi

echo "Uninstalling smart-motd…"

# systemd units (only when systemd is actually running, not just installed —
# Docker / chroots have systemctl on PATH but daemon-reload bombs there).
if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    for u in smart-motd-cache.timer smart-motd-cache.service \
             smart-motd-render.timer smart-motd-render.service; do
        systemctl disable --now "$u" 2>/dev/null || true
        rm -f "/etc/systemd/system/$u"
    done
    systemctl daemon-reload 2>/dev/null || true
else
    # Just clean up the unit files; nothing to disable.
    rm -f /etc/systemd/system/smart-motd-cache.timer \
          /etc/systemd/system/smart-motd-cache.service \
          /etc/systemd/system/smart-motd-render.timer \
          /etc/systemd/system/smart-motd-render.service
fi

# update-motd.d hook
rm -f /etc/update-motd.d/01-smart-motd

# Restore every other script in /etc/update-motd.d/ — install.sh disables
# them all (so distro defaults don't leak under our banner), uninstall
# blanket-re-enables them.
if [[ -d /etc/update-motd.d ]]; then
    for f in /etc/update-motd.d/*; do
        [[ -f "$f" ]] && chmod +x "$f" 2>/dev/null || true
    done
fi
if [[ -d /etc/motd.d ]]; then
    for f in /etc/motd.d/*; do
        [[ -f "$f" ]] && chmod +x "$f" 2>/dev/null || true
    done
fi

# cron entries
if command -v crontab >/dev/null 2>&1; then
    crontab -l 2>/dev/null | grep -v 'smart-motd\|motd-cache-update' | crontab - 2>/dev/null || true
fi

# SSH login alert PAM hook — strip our injected lines from /etc/pam.d/sshd.
# Matches both the "# smart-motd SSH login alert hook" comment and the
# pam_exec line itself (and tolerates a leading blank line).
if [[ -f /etc/pam.d/sshd ]]; then
    sed -i.smart-motd-prev \
        -e '/# smart-motd SSH login alert hook/d' \
        -e '\|pam_exec.so.*motd-ssh-alert|d' \
        /etc/pam.d/sshd 2>/dev/null || true
    rm -f /etc/pam.d/sshd.smart-motd-prev
fi

# Secrets file (bot token / chat ID). We DO remove this on uninstall —
# leaving credentials behind would be a footgun.
rm -f /etc/smart-motd/secrets.conf

# Clear /etc/motd if it was set by us (we can't be 100% sure; only blank it).
: >/etc/motd 2>/dev/null || true

# Bash completion files
rm -f /usr/share/bash-completion/completions/smart-motd \
      /etc/bash_completion.d/smart-motd

# Files
rm -rf "$PREFIX" "$CACHE_DIR"
rm -f "$BIN_DIR/smart-motd"

echo "Removed install dir and binaries."
echo "Config dir $CONFIG_DIR was kept (contains your settings). Remove manually if you want:"
echo "  sudo rm -rf $CONFIG_DIR"
