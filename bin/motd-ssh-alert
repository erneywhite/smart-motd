#!/usr/bin/env bash
# smart-motd: SSH-login alert sender. Triggered by pam_exec on every
# successful sshd session open. Reads /etc/smart-motd/{config,secrets}.conf,
# composes a message in the configured language, fires it off to Telegram
# in the background, and exits 0 immediately so login is not delayed.
#
# Environment from pam_exec:
#   PAM_USER      — the authenticated username
#   PAM_RHOST     — the client IP (or hostname)
#   PAM_TYPE      — open_session / close_session / auth …
#   PAM_SERVICE   — should be "sshd" for ssh logins

set -u

SMART_MOTD_PREFIX="${SMART_MOTD_PREFIX:-/usr/local/lib/smart-motd}"
SMART_MOTD_CONFIG="${SMART_MOTD_CONFIG:-/etc/smart-motd/config.conf}"
SMART_MOTD_SECRETS="${SMART_MOTD_SECRETS:-/etc/smart-motd/secrets.conf}"

# Only fire on session open events from sshd. Skip everything else
# (close_session, password change, sudo, su, …).
[[ "${PAM_TYPE:-}" == "open_session" ]] || exit 0
[[ "${PAM_SERVICE:-sshd}" == "sshd" ]] || exit 0

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_ALERTS_LANG=en
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_THREAD_ID=""
TELEGRAM_ALERTS_IP_WHITELIST=()
# Additional Telegram destinations beyond the primary (TOKEN/CHAT/THREAD)
# tuple above. Each entry is "token|chat_id|thread_id" — useful for sending
# the same alert to several chats (e.g. your own + a client's).
TELEGRAM_DESTS=()
# Look up the connecting IP's city/country and add it to the message. Off by
# default: it sends that IP to a third-party service on every login.
TELEGRAM_ALERTS_GEOIP=false
# Extra address blocks to never geolocate, on top of the private ranges that
# are always skipped. Same syntax as the whitelist: bare IP or CIDR.
TELEGRAM_ALERTS_GEOIP_SKIP=()

# shellcheck disable=SC1090
[[ -r "$SMART_MOTD_CONFIG" ]]  && . "$SMART_MOTD_CONFIG"
# shellcheck disable=SC1090
[[ -r "$SMART_MOTD_SECRETS" ]] && . "$SMART_MOTD_SECRETS"

[[ "$TELEGRAM_ALERTS_ENABLED" == "true" ]] || exit 0
command -v curl >/dev/null 2>&1 || exit 0

# Build the unified destination list: the legacy primary tuple plus any
# extras in TELEGRAM_DESTS. Bail entirely if neither is configured.
ALL_DESTS=()
if [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
    ALL_DESTS+=("${TELEGRAM_BOT_TOKEN}|${TELEGRAM_CHAT_ID}|${TELEGRAM_THREAD_ID:-}")
fi
for d in "${TELEGRAM_DESTS[@]:-}"; do
    [[ -n "$d" ]] && ALL_DESTS+=("$d")
done
[[ ${#ALL_DESTS[@]} -gt 0 ]] || exit 0

USER_NAME="${PAM_USER:-unknown}"
RHOST="${PAM_RHOST:-unknown}"

# Server identity for the message: full hostname (FQDN if configured) plus
# the server's primary interface IP in parentheses. Helps the operator
# instantly tell which of N servers fired the alert.
#
# Priority deliberately puts the LOCAL primary interface IP first — for
# servers behind NAT (home boxes, cloud VMs with no public IP attached,
# k8s nodes …) the public IP is the NAT gateway's address, which is the
# SAME for every server behind that NAT and useless for identification.
# `ip route get` consults the kernel routing table without sending any
# traffic, returning whatever source IP the box would use for outbound.
# Prefer plain `hostname` (the kernel hostname — i.e. what the operator
# actually set via `hostnamectl set-hostname` or /etc/hostname). `hostname -f`
# does a DNS lookup that on cloud / NAT'd hosts often returns a generic
# auto-generated name (e.g. "server-xxxx.localdomain") instead of the
# operator's real choice. Only fall back to -f if `hostname` somehow fails.
HOSTNAME_FULL="$(hostname 2>/dev/null || hostname -f 2>/dev/null || echo unknown)"
SERVER_IP=""
if command -v ip >/dev/null 2>&1; then
    SERVER_IP=$(ip route get 1.1.1.1 2>/dev/null \
        | awk '{for(i=1;i<=NF;i++) if($i=="src") {print $(i+1); exit}}')
fi
# Last-resort fallback: cached public IP. Only useful when `ip` isn't
# available (rare) — falls back to the NAT-gateway address otherwise.
if [[ -z "$SERVER_IP" ]] && [[ -r "${SMART_MOTD_CACHE_DIR:-/var/cache/smart-motd}/public_ip" ]]; then
    SERVER_IP=$(cat "${SMART_MOTD_CACHE_DIR:-/var/cache/smart-motd}/public_ip" 2>/dev/null)
    [[ "$SERVER_IP" == "unavailable" ]] && SERVER_IP=""
fi
if [[ -n "$SERVER_IP" ]]; then
    SERVER_DISPLAY="${HOSTNAME_FULL} (${SERVER_IP})"
else
    SERVER_DISPLAY="$HOSTNAME_FULL"
fi

# ---- IPv4 range matching ----
# Shared by the alert whitelist and the geo skip list, so both understand
# exactly the same syntax: a bare address or a CIDR block.
_ip_to_int() {
    local ip="$1" o1 o2 o3 o4 o
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    IFS=. read -r o1 o2 o3 o4 <<<"$ip"
    for o in "$o1" "$o2" "$o3" "$o4"; do
        (( o >= 0 && o <= 255 )) || return 1
    done
    printf '%d' "$(( (o1<<24) + (o2<<16) + (o3<<8) + o4 ))"
}

# _ip_in_cidr IP ENTRY — ENTRY is "203.0.113.5" or "192.168.1.0/24".
# Returns non-zero for anything it can't parse, including IPv6, so callers
# can loop over a mixed list without special-casing.
_ip_in_cidr() {
    local ip="$1" entry="$2" ip_int net bits net_int mask
    [[ -n "$entry" ]] || return 1
    ip_int=$(_ip_to_int "$ip") || return 1
    if [[ "$entry" != */* ]]; then
        [[ "$ip" == "$entry" ]]
        return
    fi
    net="${entry%/*}"; bits="${entry#*/}"
    [[ "$bits" =~ ^[0-9]+$ ]] || return 1
    (( bits >= 0 && bits <= 32 )) || return 1
    net_int=$(_ip_to_int "$net") || return 1
    (( bits == 0 )) && return 0
    mask=$(( 0xFFFFFFFF & (~((1 << (32 - bits)) - 1)) ))
    (( (ip_int & mask) == (net_int & mask) ))
}

# IP whitelist — silently skip the alert when the connecting IP matches an
# entry in TELEGRAM_ALERTS_IP_WHITELIST. Useful to suppress notifications
# about your own logins from a known office / home / VPN range.
for entry in "${TELEGRAM_ALERTS_IP_WHITELIST[@]:-}"; do
    [[ -n "$entry" ]] || continue
    _ip_in_cidr "$RHOST" "$entry" && exit 0
done

# Address blocks that are never sent to a geolocation service. Everything an
# IP database cannot meaningfully place: all three RFC1918 private ranges,
# loopback, link-local and carrier-grade NAT.
_GEO_SKIP_DEFAULT=(
    0.0.0.0/8         # "this network"
    10.0.0.0/8        # RFC1918 private
    100.64.0.0/10     # CGNAT (RFC6598)
    127.0.0.0/8       # loopback
    169.254.0.0/16    # link-local
    172.16.0.0/12     # RFC1918 private
    192.168.0.0/16    # RFC1918 private
)

# Resolve an IP to "City, Country" via a keyless HTTPS lookup service.
#
# Prints nothing when the address isn't publicly routable, when no service
# answers, or when the answer carries no usable fields — the caller then omits
# the line entirely rather than printing "unknown".
_geo_lookup() {
    local ip="$1" url json city country
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ || "$ip" == *:* ]] || return 0
    # Never hand these to a lookup service: a public geo database can't say
    # anything meaningful about them anyway. Operators whose internal network
    # sits on some other range can extend this via TELEGRAM_ALERTS_GEOIP_SKIP.
    local skip
    for skip in "${_GEO_SKIP_DEFAULT[@]}" "${TELEGRAM_ALERTS_GEOIP_SKIP[@]:-}"; do
        [[ -n "$skip" ]] || continue
        _ip_in_cidr "$ip" "$skip" && return 0
    done
    # IPv6 by prefix — 128-bit CIDR math in bash isn't worth the lines.
    case "$ip" in
        ::1|fe80:*|fc*:*|fd*:*) return 0 ;;
    esac
    # Two providers, tried in order. Both are keyless and speak HTTPS; the
    # parsing is deliberately generic (no jq — this project ships with no
    # runtime dependencies) so swapping in another service is a URL change.
    for url in "https://ipwho.is/${ip}" "https://ipapi.co/${ip}/json/"; do
        json=$(curl -fsS --max-time 4 "$url" 2>/dev/null) || continue
        [[ -n "$json" ]] || continue
        city=$(printf '%s' "$json" \
            | grep -oE '"city"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
            | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/')
        # Prefer the spelled-out name; "country" alone is a 2-letter code on
        # some services and the full name on others.
        country=$(printf '%s' "$json" \
            | grep -oE '"country_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
            | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/')
        [[ -z "$country" ]] && country=$(printf '%s' "$json" \
            | grep -oE '"country"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
            | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/')
        if [[ -n "$city" && -n "$country" ]]; then
            printf '%s, %s' "$city" "$country"; return 0
        fi
        [[ -n "$country" ]] && { printf '%s' "$country"; return 0; }
    done
    return 0
}

# Everything below runs in ONE detached subshell.
#
# Both enrichment steps hit the network, and pam_exec waits for this script to
# exit before the user gets their shell. Reverse DNS used to run inline, which
# quietly added up to 3s to every login on a slow resolver; adding the geo
# lookup beside it would have doubled that. Now the script returns immediately
# and the message is enriched, composed and delivered in the background.
(
    # Best-effort reverse DNS. Still capped, so a black-holed resolver can't
    # leave this subshell hanging around forever.
    RDNS=""
    if [[ "$RHOST" =~ ^[0-9a-fA-F.:]+$ ]]; then
        if command -v dig >/dev/null 2>&1; then
            RDNS=$(timeout 3 dig +short -x "$RHOST" 2>/dev/null | head -1 | sed 's/\.$//')
        elif command -v host >/dev/null 2>&1; then
            RDNS=$(timeout 3 host "$RHOST" 2>/dev/null | awk '/domain name pointer/ {print $NF; exit}' | sed 's/\.$//')
        elif command -v getent >/dev/null 2>&1; then
            RDNS=$(timeout 3 getent hosts "$RHOST" 2>/dev/null | awk '{print $2}')
        fi
    fi

    # Optional geolocation. Off by default: it hands the source IP of every
    # SSH login to a third-party service, which is the operator's call to make
    # rather than something to inherit silently on upgrade.
    GEO=""
    [[ "${TELEGRAM_ALERTS_GEOIP:-false}" == "true" ]] && GEO=$(_geo_lookup "$RHOST")

    if [[ "$TELEGRAM_ALERTS_LANG" == "ru" ]]; then
        TS=$(date '+%d.%m.%Y %H:%M:%S %Z')
        MSG="🔓 SSH вход на сервер
👤 Пользователь: ${USER_NAME}
🌐 IP: ${RHOST}"
        [[ -n "$RDNS" ]] && MSG+="
🌐 rDNS: ${RDNS}"
        [[ -n "$GEO" ]] && MSG+="
🌍 Локация: ${GEO}"
        MSG+="
🖥 Сервер: ${SERVER_DISPLAY}
🕐 ${TS}"
    else
        TS=$(date '+%Y-%m-%d %H:%M:%S %Z')
        MSG="🔓 SSH login
👤 User: ${USER_NAME}
🌐 IP: ${RHOST}"
        [[ -n "$RDNS" ]] && MSG+="
🌐 rDNS: ${RDNS}"
        [[ -n "$GEO" ]] && MSG+="
🌍 Location: ${GEO}"
        MSG+="
🖥 Server: ${SERVER_DISPLAY}
🕐 ${TS}"
    fi

    # One send per destination, each independent, so a slow or unreachable
    # endpoint doesn't hold up the others.
    for dest in "${ALL_DESTS[@]}"; do
        IFS='|' read -r d_token d_chat d_thread <<<"$dest"
        [[ -n "$d_token" && -n "$d_chat" ]] || continue
        (
            URL="https://api.telegram.org/bot${d_token}/sendMessage"
            args=(
                --data-urlencode "chat_id=${d_chat}"
                --data-urlencode "text=${MSG}"
                --data-urlencode "disable_web_page_preview=true"
            )
            [[ -n "$d_thread" ]] && args+=( --data-urlencode "message_thread_id=${d_thread}" )
            curl -fsS --max-time 8 "${args[@]}" "$URL" >/dev/null 2>&1
        ) &
    done
    wait
) >/dev/null 2>&1 &
disown 2>/dev/null || true

exit 0
